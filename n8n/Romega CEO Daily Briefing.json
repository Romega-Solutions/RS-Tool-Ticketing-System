{
  "name": "Romega CEO Daily Briefing",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 23 * * *"
            }
          ]
        }
      },
      "id": "a-cron",
      "name": "Daily 7 AM PHT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 304],
      "notesInFlow": true,
      "notes": "23:00 UTC = 07:00 PHT (UTC+8)"
    },
    {
      "parameters": {
        "method": "POST",
