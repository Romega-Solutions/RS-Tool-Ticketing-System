# ─────────────────────────────────────────────────────────────────────────────
# RS Tool Ticketing System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL of your deployment (used for OpenGraph metadata).
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project → Settings → API

# Your Supabase project URL  (safe to expose — used client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon / public key  (safe to expose — used client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key  (KEEP SECRET — server-side only, used for admin user creation)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL connection string — Transaction mode pooler (port 6543)
# Found in: Supabase → Project → Settings → Database → Connection string → Transaction
DATABASE_URL=postgresql://postgres.your-project-id:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Optional — only if you enable Google Sign-In in Supabase.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Org Chart API ──────────────────────────────────────────────────────────────
# Found in: tools.romega-solutions.com → Org Chart → Settings → API Integration
ORG_CHART_API_KEY=your-org-chart-api-key

# ── Wise (live USD→PHP exchange rate) ────────────────────────────────────────
# Source of truth for the USD→PHP rate shown on the rates page, profile,
# dashboard, and payroll export. Uses Wise's self-serve personal/business
# API (GET /v1/rates) — NOT the partnership-only Wise Platform API.
#
# Get a token: Wise → Settings → API tokens → Create.  Read-only is enough.
# If WISE_API_TOKEN is empty, the app falls back to the free open.er-api.com
# feed automatically, so this is optional for local dev.
WISE_API_TOKEN=
# Production: https://api.transferwise.com  ·  Sandbox: https://api.sandbox.transferwise.tech
WISE_API_URL=https://api.transferwise.com

# ── Auto Clock-Out Cron ──────────────────────────────────────────────────────
# Required. Bearer token gating /api/cron/auto-clock-out. Generate with:
#   openssl rand -hex 24
# Used by the Vercel daily cron and by the n8n every-minute trigger that
# runs the same endpoint. The handler returns 500 if this is unset.
CRON_SECRET=

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to 'true' to show dummy login accounts on the login page.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false

# ── Dev password sign-in ──────────────────────────────────────────────────────
# The email+password sign-in block on /login (src/app/login/page.tsx) is always
# shown when NODE_ENV=development (local `npm run dev`). Vercel builds — staging
# AND production — always run with NODE_ENV=production, so this flag is the only
# way to surface that block on a deployed environment. Set to 'true' ONLY in the
# Vercel Staging environment's env vars (never Production), so QA/reviewers can
# sign in with a Supabase Auth user's email/password instead of Google OAuth.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false

# ── n8n Resume Parser (Recruiting / ATS) ─────────────────────────────────────
# Full URL of the "Romega ATS — Resume Extractor (Regex, No API Key)" workflow.
#
# This uses the regex-based workflow — no Claude/OpenAI API key needed.
# Import n8n/Romega ATS — Resume Extractor (Regex, No API Key).json into your
# self-hosted n8n, activate it, and copy the production Form URL.
#
# The shipped JSON wires the Form Trigger to a "Respond to Webhook" node, so
# programmatic POSTs to /form/<uuid> return JSON instead of an HTML success page.
#
# Example: https://n8n-romega-n8n.ikuuwb.easypanel.host/form/<your-uuid>
#
# PDF only. The regex parser would also work on DOCX, but n8n's Code-node
# sandbox blocks the Node modules needed to unzip a .docx (zlib, jszip,
# adm-zip). To enable DOCX:
#   1. On your n8n container, set the env var:
#        NODE_FUNCTION_ALLOW_EXTERNAL=jszip
#      (or NODE_FUNCTION_ALLOW_BUILTIN=zlib if you prefer the pure-Node path)
#   2. Restart n8n.
#   3. Re-add the DOCX branch to the workflow and re-enable DOCX in
#      src/lib/n8n.ts ALLOWED_MIME_TYPES + the file picker's `accept`.
N8N_RESUME_PARSER_URL=https://n8n-romega-n8n.ikuuwb.easypanel.host/form/34a0c7fc-e9d1-4bac-a907-d1c84fd78874
# AI parser (Groq, "Romega ATS — Resume Extractor (AI / Groq)"). Chosen from the
# recruiter's "Add from resume" popup. Far more accurate on varied layouts.
# The Groq API key lives in an n8n credential, NOT here.
N8N_RESUME_PARSER_AI_URL=https://n8n-romega-n8n.ikuuwb.easypanel.host/form/ffca4135-74d2-4c98-910c-8b5e4f465a97

# ── n8n REST API (for managing workflows programmatically) ────────────────────
# Optional — only needed if you re-deploy/edit n8n workflows from this repo.
# Create a personal API key in n8n: Settings → API → Create API key.
# Used by scripts like `python3 -m n8n_deploy` to push workflow JSON updates.
N8N_API_URL=https://n8n-romega-n8n.ikuuwb.easypanel.host/api/v1
N8N_API_KEY=

# ── Groq API (Llama 3.x / Mixtral inference, free tier) ───────────────────────
# Alternative to Google Gemini for the AI-powered lead-tool features
# (CEO Daily Briefing, PM Weekly Status Drafter, Content Repurposer, etc.).
# Free tier as of 2026-05: Llama-3.3-70B → 6,000 TPM / 14,400 RPD.
# Get a key at https://console.groq.com/keys (free signup, no card).
# Endpoint: https://api.groq.com/openai/v1/chat/completions (OpenAI-compatible).
GROQ_API_KEY=

# ── CEO Briefing cron auth ────────────────────────────────────────────────────
# Long random string. The n8n daily cron sends it as `Authorization: Bearer ...`
# when calling POST /api/ceo/briefing/generate. Generate with:
#   openssl rand -hex 24
N8N_BRIEFING_SECRET=

# The public URL of this Next.js app — used by the n8n cron so it can call us.
# Locally: http://localhost:3000  ·  Vercel: https://your-app.vercel.app
APP_BASE_URL=http://localhost:3000

# ── Recruitment AI Agent (ATS automation) ─────────────────────────────────────
# Webhook URL for the n8n "Romega ATS — Candidate Communication" workflow.
# Triggered on candidate creation and on status changes that have an auto-email
# template. Returns { ok, template } JSON.
#
# Find it in n8n: open the workflow → click the Webhook node → copy the
# production URL. Looks like:
#   https://n8n.example.host/webhook/ats-candidate-communication
N8N_COMMUNICATION_WEBHOOK_URL=

# Supabase Storage bucket name for candidate resumes. Defaults to
# `candidate-resumes` when unset. Create the bucket once (private) via the
# Supabase dashboard or the SQL snippet in docs/RECRUITMENT_AI_AGENT_BUILD_PLAN.md §4.
SUPABASE_RESUMES_BUCKET=candidate-resumes
SUPABASE_CANDIDATE_PREEMPLOYMENT_BUCKET=candidate-pre-employment-docs

# Webhook URL for the n8n "Romega ATS — Recruiter Notify" workflow.
# Pings the assigned recruiter when a new public application lands at /apply/[id].
# Optional — if unset, recruiter notifications are skipped (the candidate is
# still created and the acknowledgment email still fires).
N8N_RECRUITER_NOTIFY_URL=

# ── Account-setup email (User Management) ─────────────────────────────────────
# Reuses the GENERIC n8n sender "OpenClaw - Send Email via Gmail"
# (path /webhook/openclaw-send-email). This app renders the editable template and
# POSTs { to, subject, body }; the workflow sends `body` as a plain-text Gmail and
# responds { status: 'sent' | 'error' }.
# Optional — if unset, the "Send setup email" action returns a clear error.
N8N_ACCOUNT_SETUP_URL=https://n8n-romega-n8n.ikuuwb.easypanel.host/webhook/openclaw-send-email

# Optional — dedicated HTML-capable Gmail sender for general notification
# emails (src/lib/n8n.ts sendNotificationEmail). When unset, falls back to
# N8N_ACCOUNT_SETUP_URL above (plain-text sender).
N8N_NOTIFICATION_EMAIL_URL=

# ── Recruiting pipeline automations ───────────────────────────────────────────
# Read by src/app/(app)/recruiting/automations/page.tsx to show which stage
# emails are wired. The matching n8n workflows are NOT in this repo yet — leave
# each blank until its workflow is built, imported, and activated in n8n.
N8N_INTERVIEW_INVITE_URL=
N8N_FINAL_INTERVIEW_INVITE_URL=
N8N_OFFER_SOW_URL=
N8N_CLIENT_ENDORSEMENT_URL=
N8N_ONBOARDING_REFERENCES_URL=

# Recruitment pre-employment forms. JOTFORM_BG_CHECK_FORM_URL is the base
# Jotform URL; the app appends request_token, candidate_name, and
# candidate_email as prefill parameters. n8n uses the secret to submit the
# completed payload to /api/automations/pre-employment/submissions.
JOTFORM_BG_CHECK_FORM_URL=
JOTFORM_REFERENCE_CHECK_FORM_URL=
N8N_PRE_EMPLOYMENT_SECRET=

# ── LMS reminders ─────────────────────────────────────────────────────────────
# Webhook for the n8n workflow that nudges learners with overdue lessons.
# Called by src/app/api/lms/reminders/route.ts. Optional.
N8N_LMS_REMINDER_WEBHOOK_URL=

# ── Internal Onboarding (docs/INTERNAL_ONBOARDING_MVP_SETUP.md) ──────────────
# The four MVP n8n webhook URLs. Each maps to one Gmail template the
# Onboarding Lead fires from /onboarders/[id]. Leaving a URL blank does not
# break the app — the send action records `email_failed` in onboarder_history
# and surfaces a Resend button. Configure each once the matching n8n workflow
# is imported.
N8N_BG_CHECK_INITIATE_URL=
N8N_REFERENCE_REQUEST_URL=
N8N_EMPLOYMENT_VERIFICATION_URL=
N8N_PRE_EMPLOYMENT_DOCUMENTS_SEND_URL=
JOTFORM_EMPLOYMENT_VERIFICATION_FORM_URL=
N8N_ONBOARDING_WELCOME_URL=
# One shared, linkless manual reminder workflow for Recruitment + Onboarding.
N8N_FORM_REMINDER_URL=

# Post-MVP onboarding webhooks — placeholders only. Setting them does
# nothing until the matching UI / cron lands in post-MVP phases.
N8N_GMAIL_SIGNATURE_NUDGE_URL=
N8N_GROUP_CHAT_ANNOUNCE_URL=
N8N_SOW_REMINDER_URL=
N8N_DAY1_CALENDAR_URL=
N8N_30DAY_CHECKIN_URL=
N8N_90DAY_REVIEW_URL=

# Supabase Storage bucket name for onboarder documents (SOW, W-8, gov IDs,
# NBI, reference responses, employment verification PDFs). Defaults to
# `onboarder-docs`. Bucket must be PRIVATE — the app issues signed URLs.
# Created by the migration in docs/migrations/add-onboarders-tables.sql.
SUPABASE_ONBOARDER_BUCKET=onboarder-docs

# Supabase Storage bucket name for work-item (PM/ticket) image attachments —
# JPG/PNG screenshots embedded in task descriptions. Defaults to `task-images`.
# Bucket must be PRIVATE — the app issues signed URLs. Without it, every task
# image upload fails with "Bucket not found".
SUPABASE_TASK_IMAGES_BUCKET=task-images

# Supabase Storage bucket name for LMS lesson videos AND auto-generated
# certificate PDFs. Defaults to `learning-content`. PRIVATE; signed URLs. No
# size cap (videos are large). Without it, video uploads and certificate
# issuance fail with "Bucket not found".
SUPABASE_LEARNING_BUCKET=learning-content

# Supabase Storage bucket name for optional supporting files attached to
# timesheet edit-requests. Defaults to `timesheet-edit-docs`. PRIVATE.
SUPABASE_TIMESHEET_DOCS_BUCKET=timesheet-edit-docs

# All five Supabase buckets above are provisioned (idempotently) by
# docs/migrations/add-storage-buckets.sql — run it once against a fresh DB.

# ── Public applications endpoint ──────────────────────────────────────────────
# Shared bearer token used by external sites (e.g. RS_Web-Digital marketing
# site at romega-solutions.com) to authenticate POSTs to
# /api/public/applications/[positionId]. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This same value must be set in RS_Web-Digital/.env as PUBLIC_APPLICATIONS_TOKEN.
PUBLIC_APPLICATIONS_TOKEN=replace-with-random-64-char-hex-token

# ── Romega Tools hub (/tools launcher) ────────────────────────────────────────
# Deployed URLs for the external Romega apps surfaced on the in-portal Tools
# page. Read server-side (not NEXT_PUBLIC) — access is gated by role/team.
# Leave any blank to render that card as "Not configured" (disabled).
TOOL_EMAIL_SIGNATURE_URL=
TOOL_ORG_CHART_URL=
TOOL_CERTIFICATE_CREATOR_URL=
# Development Tools section (admins only) — external workspace links.
DEV_TOOL_GITHUB_URL=
DEV_TOOL_VERCEL_URL=
DEV_TOOL_FIGMA_URL=
