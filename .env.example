# ─────────────────────────────────────────────────────────────────────────────
# RS Tool Ticketing System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL of your deployment (used for OpenGraph metadata).
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project → Settings → API

# Your Supabase project URL  (safe to expose — used client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon / public key  (safe to expose — used client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key  (KEEP SECRET — server-side only, used for admin user creation)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL connection string — Transaction mode pooler (port 6543)
# Found in: Supabase → Project → Settings → Database → Connection string → Transaction
DATABASE_URL=postgresql://postgres.your-project-id:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Plane.so ──────────────────────────────────────────────────────────────────
# Your self-hosted or cloud Plane instance
PLANE_BASE_URL=https://your-plane-instance.example.com

# Found in: Plane → Profile → API Tokens
PLANE_API_KEY=plane_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Plane workspace identifier (the slug in the URL)
PLANE_WORKSPACE_SLUG=your-workspace-slug

# ── Report Script (Python) ────────────────────────────────────────────────────
# Optional — defaults work if the Python venv is active.
# Set these only if you need to override the auto-detected paths.

# Absolute path to the report-script/ directory
# REPORT_SCRIPT_DIR=/absolute/path/to/report-script

# Absolute path to the Python binary (e.g. inside the venv)
# REPORT_SCRIPT_PYTHON=/absolute/path/to/report-script/venv/bin/python

# ── Org Chart API ──────────────────────────────────────────────────────────────
# Found in: tools.romega-solutions.com → Org Chart → Settings → API Integration
ORG_CHART_API_KEY=your-org-chart-api-key

# ── Legacy (no longer required) ───────────────────────────────────────────────
# JWT_SECRET was used before Supabase Auth. No longer needed but kept
# here so old deployments don't break during the transition.
# JWT_SECRET=generate-with: openssl rand -base64 32
