# Plane.so API Configuration
# Get your API key from: Plane Settings → API Tokens → Create Token
PLANE_BASE_URL=https://romega-projects-rs-plane.ikuuwb.easypanel.host/
PLANE_API_KEY=plane_api_xxxxxxxxxxxxxxxxxxxxxxxx
PLANE_WORKSPACE_SLUG=romega

# Optional: filter report to a single project by its identifier (e.g. "C3")
# Leave blank to include all projects in the workspace
PLANE_PROJECT_SLUG=

# Output directory for generated reports
REPORT_OUTPUT_DIR=./reports
